  "fixed_sql": [
    {
      "name": "user_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profiles\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"level\" TEXT NOT NULL, \"daily_minutes\" INTEGER NOT NULL, \"streak\" INTEGER NOT NULL DEFAULT 0, \"last_study_date\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "weekly_plan_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weekly_plan_days\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"week_start\" INTEGER NOT NULL, \"day_index\" INTEGER NOT NULL, \"grammar_topic\" TEXT NOT NULL, \"vocab_theme\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'pending');"
        }
      ]
    },
    {
      "name": "lessons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lessons\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"lesson_date\" INTEGER NOT NULL, \"content_json\" TEXT NOT NULL, \"score\" REAL NULL, \"duration_seconds\" INTEGER NOT NULL DEFAULT 0, \"completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"completed\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "mistakes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mistakes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"item\" TEXT NOT NULL, \"context\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"times_wrong\" INTEGER NOT NULL DEFAULT 1, \"times_correct\" INTEGER NOT NULL DEFAULT 0, \"last_asked_at\" INTEGER NULL, \"resolved\" INTEGER NOT NULL DEFAULT 0 CHECK (\"resolved\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "flashcards",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"flashcards\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"word\" TEXT NOT NULL, \"meaning\" TEXT NOT NULL, \"example_sentence\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"ease\" REAL NOT NULL DEFAULT 2.5, \"interval_days\" INTEGER NOT NULL DEFAULT 0, \"reps\" INTEGER NOT NULL DEFAULT 0, \"due_date\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "stories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"story_date\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"content_json\" TEXT NOT NULL, \"quiz_score\" REAL NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "weekly_reviews",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weekly_reviews\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"week_start\" INTEGER NOT NULL, \"report_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    }
